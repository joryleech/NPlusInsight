<a class="crumb" href="<%= root_path %>">&larr; All detections</a>
<div class="row">
  <div>
    <h1><%= @detection.method %> <%= @detection.path %></h1>
    <p class="muted">
      <%= @detection.query_count %> repeated queries
      &middot; <%= @detection.query_groups.length %> query pattern<%= "s" unless @detection.query_groups.one? %>
      &middot; <%= @detection.total_ms %> ms total
      &middot; <%= @detection.created_at %>
    </p>
  </div>
  <span class="badge">N+1 detected</span>
</div>

<div class="grid">
  <div class="stack">
    <section>
      <h2>Exact source location</h2>
      <% if @detection.location %>
        <p><%= @detection.location.path %>:<%= @detection.location.line %></p>
        <pre class="source"><% @detection.location.snippet.each do |line| %><div class="<%= "active" if line[:active] %>"><b><%= line[:line] %></b><span><%= line[:text] %></span></div><% end %></pre>
      <% else %>
        <p class="muted">The queries were captured, but no application stack frame was available.</p>
      <% end %>
    </section>

    <section>
      <h2>Repeated query patterns</h2>
      <div class="query-patterns">
        <% @detection.query_groups.each_with_index do |group, index| %>
          <div class="query-pattern">
            <div class="row">
              <h3>Pattern <%= index + 1 %></h3>
              <span class="badge"><%= group[:query_count] %> queries &middot; <%= group[:total_ms] %> ms</span>
            </div>
            <p class="muted"><%= group[:tables].join(", ") %></p>
            <pre><%= group[:sql] %></pre>
          </div>
        <% end %>
      </div>
    </section>

    <section>
      <div class="row">
        <div>
          <h2>Query loading waterfall</h2>
          <p class="muted waterfall-summary">
            <%= @detection.waterfall_ms %> ms elapsed
            &middot; <%= @detection.total_ms %> ms database time
            &middot; Hover a bar for its start time and duration
          </p>
        </div>
        <span class="badge"><%= @detection.query_count %> queries</span>
      </div>
      <div
        class="waterfall"
        role="img"
        aria-label="Waterfall of repeated query patterns over <%= @detection.waterfall_ms %> milliseconds">
        <div class="waterfall-axis" aria-hidden="true">
          <span>0 ms</span>
          <span><%= @detection.waterfall_ms %> ms</span>
        </div>
        <% span_ms = [@detection.waterfall_ms.to_f, 0.01].max %>
        <% @detection.query_groups.each_with_index do |group, pattern_index| %>
          <div class="waterfall-row">
            <div class="waterfall-label">
              <strong>Pattern <%= pattern_index + 1 %></strong>
              <small><%= group[:tables].join(", ") %></small>
            </div>
            <div class="waterfall-track">
              <% (group[:waterfall] || []).each do |query| %>
                <% start_percent = [[query[:offset_ms].to_f / span_ms * 100, 0].max, 100].min %>
                <% width_percent = [[query[:duration_ms].to_f / span_ms * 100, 0].max, 100 - start_percent].min %>
                <% edge_class = start_percent < 20 ? "waterfall-bar-start" : (start_percent > 80 ? "waterfall-bar-end" : nil) %>
                <% tooltip_id = "waterfall-tooltip-#{pattern_index}-#{query[:index]}" %>
                <span
                  class="waterfall-bar <%= edge_class %>"
                  style="--waterfall-start:<%= start_percent.round(4) %>%;--waterfall-width:<%= width_percent.round(4) %>%"
                  tabindex="0"
                  aria-describedby="<%= tooltip_id %>">
                  <span class="waterfall-tooltip" id="<%= tooltip_id %>" role="tooltip">
                    <strong>Query <%= query[:index] %></strong>
                    <span><%= query[:duration_ms] %> ms</span>
                    <small>Started +<%= query[:offset_ms] %> ms</small>
                  </span>
                </span>
              <% end %>
            </div>
            <span class="waterfall-total"><%= group[:total_ms] %> ms</span>
          </div>
        <% end %>
      </div>
    </section>

    <section>
      <h2>Suggested fixes</h2>
      <% @detection.suggestions.each do |suggestion| %>
        <div class="suggestion">
          <div class="row"><h3><%= suggestion[:title] %></h3><span class="badge"><%= suggestion[:confidence] %> confidence</span></div>
          <p class="muted"><%= suggestion[:explanation] %></p>
          <pre><%= suggestion[:code] %></pre>
        </div>
      <% end %>
    </section>

    <% if @detection.location %>
      <% frames = @detection.location.backtrace.presence || [{ path: @detection.location.path, line: @detection.location.line, label: @detection.location.label }] %>
      <section>
        <details class="method-backtrace">
          <summary>
            <span>
              <strong>Method backtrace</strong>
              <small>Expand to trace the query through serializers and other application methods</small>
            </span>
            <span class="badge"><%= frames.length %> frame<%= "s" unless frames.one? %></span>
          </summary>
          <ol>
            <% frames.each do |frame| %>
              <li>
                <code><%= frame[:label].presence || "(unknown method)" %></code>
                <span><%= frame[:path] %>:<%= frame[:line] %></span>
              </li>
            <% end %>
          </ol>
        </details>
      </section>
    <% end %>
  </div>

  <section>
    <h2>Affected model tree</h2>
    <% render_tree = lambda do |nodes| %>
      <% content_tag(:ul, class: "model-tree") do %>
        <% safe_join(nodes.map do |node| %>
          <% content_tag(:li) do %>
            <% parts = [] %>
            <% if node[:association] %>
              <% parts << content_tag(:span, "#{node[:association]} (#{node[:macro]})", class: "tree-edge") %>
            <% end %>
            <% parts << content_tag(:div, class: "tree-node") do %>
              <% safe_join([
                content_tag(:strong, node[:name]),
                content_tag(:small, node[:table])
              ]) %>
            <% end %>
            <% parts << render_tree.call(node[:children]) if node[:children].any? %>
            <% safe_join(parts) %>
          <% end %>
        <% end) %>
      <% end %>
    <% end %>
    <div class="tree-wrap" role="img" aria-label="Tree of models and associations involved in the repeated queries">
      <%= render_tree.call(@detection.tree) %>
    </div>
  </section>
</div>
